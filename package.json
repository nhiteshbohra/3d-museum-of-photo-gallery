{
  "name": "our-museum-3d",
  "version": "1.0.0",
  "description": "Our Museum 3D - Virtual Art Sanctuary for Maya & Ethan (Crafted by Hitesh Bohra)",
  "author": "Hitesh Bohra",
  "type": "module",
  "scripts": {
    "dev": "vite build && node scripts/free_port.mjs 8080 && node server.js",
    "build": "vite build",
    "preview": "node scripts/free_port.mjs 8080 && node server.js",
    "start": "node scripts/free_port.mjs 8080 && node server.js",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "check": "npm run check:code && npm run check:photos && npm run models:verify && npm run build",
    "check:code": "node --test --test-concurrency=1 tests/*.test.mjs && node scripts/validate_layout.mjs",
    "check:photos": "node scripts/check_photos.mjs",
    "invite": "node scripts/invite.mjs",
    "photos": "python tools/organize_photos.py",
    "models:audit": "node scripts/model_manager.mjs audit",
    "models:archive": "node scripts/model_manager.mjs archive",
    "models:restore": "node scripts/model_manager.mjs restore",
    "models:verify": "node scripts/model_manager.mjs verify"
  },
  "dependencies": {
    "three": "^0.182.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "draco3dgltf": "^1.5.9",
    "vite": "^7.2.4"
  }
}
