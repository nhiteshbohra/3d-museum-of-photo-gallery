# =========================================================================
# Our Museum 3D — Production Environment Configuration
# =========================================================================

# Server Port and Host binding
PORT=8080
HOST=0.0.0.0

# Optional private access passcode for Maya & Ethan's sanctuary
# Leave empty in local development for open access without prompt.
# Set a strong secret in production.
MUSEUM_PASSCODE=

# Allowed Origins for WebSocket upgrade & HTTP CORS (comma-separated)
# Leave empty during local dev to allow localhost.
# In production with Cloudflare Tunnel, set to your custom domain:
# ALLOWED_ORIGINS=https://our-museum.yourdomain.com,https://yourdomain.com
ALLOWED_ORIGINS=

# Set to 1 if behind a reverse proxy / Cloudflare Tunnel to read CF-Connecting-IP
# Set to 0 when running locally without a reverse proxy.
TRUST_PROXY=0

# Server logging verbosity: 'debug', 'info', 'warn', 'error'
LOG_LEVEL=info

# Optional client-side WebSocket URL override (Vite build)
# Defaults to same-origin (wss:// on https, ws:// on http)
# VITE_WS_URL=wss://our-museum.yourdomain.com/ws

